{
  "name": "r2v2",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin: sync a vault between desktops through Cloudflare R2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:s3": "bash scripts/integration.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
